<header class="border-b border-gray-200 bg-white">
  <nav class="container mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <%= link_to t(".brand"), root_path, class: "text-xl font-bold text-indigo-600" %>

    <ul class="flex items-center gap-4 text-sm">
      <% if user_signed_in? %>
        <li><%= link_to t(".new_post"), new_post_path, class: "rounded bg-indigo-600 px-3 py-2 font-medium text-white hover:bg-indigo-500" %></li>
        <li class="text-gray-500"><%= current_user.email %></li>
        <li><%= link_to t(".sign_out"), destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-700 hover:text-indigo-600" %></li>
      <% else %>
        <li><%= link_to t(".sign_in"), new_user_session_path, class: "text-gray-700 hover:text-indigo-600" %></li>
        <li><%= link_to t(".sign_up"), new_user_registration_path, class: "rounded bg-indigo-600 px-3 py-2 font-medium text-white hover:bg-indigo-500" %></li>
      <% end %>
    </ul>
  </nav>
</header>
